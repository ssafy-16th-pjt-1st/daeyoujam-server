APP_NAME=Daeyoujam API
APP_VERSION=0.1.0
APP_ENV=development
SERVICE_NAME=daeyoujam-api
DATABASE_URL=sqlite:///./data/localhub.db
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
VECTOR_STORE_PATH=./data/chroma
VECTOR_COLLECTION_NAME=daeyoujam_places
VECTOR_EMBEDDING_DIM=384
OPENAI_API_KEY=replace_with_new_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Groq example:
# OPENAI_API_KEY=gsk_replace_with_new_groq_api_key
# OPENAI_MODEL=groq/compound
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
